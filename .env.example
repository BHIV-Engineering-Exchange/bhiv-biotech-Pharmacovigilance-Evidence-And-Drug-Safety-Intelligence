# BHIV BiotechSystem — Backend Environment Configuration Template
# Hariom Upadhyay | Backend Architecture & Integration | EOD 20 November 2026
#
# Copy this file to .env and fill in actual values.
# NEVER commit a .env file containing real credentials or secrets.
#
# See ARCHITECTURE.md for full configuration documentation.

# ---------------------------------------------------------------------------
# Pipeline configuration
# ---------------------------------------------------------------------------

# Maximum evidence records to retrieve per OpenFDA query
OPENFDA_LIMIT=5

# OpenFDA base URL (do not change unless testing against a mirror)
OPENFDA_URL=https://api.fda.gov/drug/event.json

# Evidence store file path (relative to project root)
EVIDENCE_STORE_FILE=evidence_output.json

# ---------------------------------------------------------------------------
# API service configuration
# ---------------------------------------------------------------------------

# Host and port for the FastAPI service
API_HOST=0.0.0.0
API_PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Integration service boundaries (not currently live — document only)
# ---------------------------------------------------------------------------

# QC Engine (Shyamal) — not merged, not installed
# QC_ENGINE_PACKAGE_PATH=/path/to/bhiv-biotech-symmetrical-octo-invention
# QC_ENGINE_BRANCH=feature/runtime-json-schema-validation

# Drug Safety (Shravani) — PR #1 not merged
# DRUG_SAFETY_BRANCH=drug-safety-evidence-integration

# MASTERDB — no connection details available
# MASTERDB_URL=
# MASTERDB_API_KEY=

# TANTRA Workflow Executor — no connection details available
# TANTRA_URL=

# ---------------------------------------------------------------------------
# Security notes
# ---------------------------------------------------------------------------
# This service does not handle patient PII.
# No authentication is currently implemented.
# Before production deployment:
#   - Add OAuth2/JWT authentication (see BLOCKERS.md)
#   - Enable HTTPS
#   - Restrict CORS origins
#   - Add rate limiting
